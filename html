<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const isDark = matchMedia('(prefers-color-scheme: dark)').matches;
const tc = isDark ? '#c8c7bf' : '#5F5E5A';
const gc = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)';

new Chart(document.getElementById('c1'), {
  type: 'doughnut',
  data: {
    labels: ['Advisory','Audit','Tax','Juridique','GTI réseau'],
    datasets: [{
      data: [8,5,2,1,3],
      backgroundColor: ['#534AB7','#1D9E75','#BA7517','#993C1D','#185FA5'],
      borderWidth: 0, hoverOffset: 5
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false, cutout: '60%',
    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' '+c.label+' : '+c.raw } } }
  }
});

new Chart(document.getElementById('c2'), {
  type: 'bar',
  data: {
    labels: ['Banque','Industrie','Intl.','Secteur pub.','Assurance','Pharma'],
    datasets: [{
      data: [7,5,3,2,1,1],
      backgroundColor: ['#185FA5','#BA7517','#888780','#534AB7','#1D9E75','#993C1D'],
      borderWidth: 0, borderRadius: 4
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { ticks: { color: tc, font: { size: 10 }, autoSkip: false, maxRotation: 30 }, grid: { display: false } },
      y: { ticks: { color: tc, font: { size: 10 }, stepSize: 1 }, grid: { color: gc }, min: 0, max: 9 }
    }
  }
});

function filter(svc) {
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  document.querySelector('.pill-'+(svc==='all'?'all':svc)).classList.add('active');
  const rows = document.querySelectorAll('#tbl-body tr');
  let count = 0;
  rows.forEach(r => {
    const show = svc === 'all' || r.dataset.svc === svc;
    r.classList.toggle('hidden', !show);
    if(show) count++;
  });
  document.getElementById('count-lbl').textContent = count + ' opportunité' + (count > 1 ? 's' : '');
}
</script>
